# HTTP transport
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp
MCP_CORS_ORIGINS=*
MCP_CORS_ALLOW_CREDENTIALS=false

# Persistent input/cache locations. Keep these outside Git.
MCP_WORKSPACE_PATH=./workspace
MCP_CACHE_PATH=./.cache/android-reverse-mcp
MCP_DEFAULT_APK=
MCP_ALLOW_EXTERNAL_PATHS=false

# Optional Android/native tooling. Values may be executable names on PATH or absolute paths.
ANDROID_SDK_ROOT=
ANDROID_HOME=
MCP_ANDROID_BUILD_TOOLS_PATH=
MCP_APKTOOL=apktool
MCP_JADX=jadx
MCP_BAKSMALI=baksmali
MCP_AAPT2=aapt2
MCP_APKANALYZER=apkanalyzer
MCP_RADARE2=r2
MCP_RABIN2=rabin2
MCP_IL2CPP_DUMPER=
MCP_CPP2IL=
MCP_UNFLUTTER=

# Safety and output bounds
MCP_COMMAND_TIMEOUT=60
MCP_MAX_OUTPUT_BYTES=1000000
MCP_MAX_INPUT_BYTES=10000000
MCP_MAX_ARCHIVE_ENTRY_BYTES=67108864
MCP_ENABLE_R2_EXECUTE=true
MCP_LOG_LEVEL=INFO
